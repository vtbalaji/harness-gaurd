{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:order-agent:model-response:mr-1",
  "title": "Model response (internal), version mr-1",
  "description": "What qwen3.5:4b must return. NOT the public contract: deterministic assembly (data-model.md A-1..A-8) turns it into an output 1.0 object. Pairing/null consistency rules MC-1..MC-3 are checked in code (MR-CONSIST). Strict: no extra keys, no case-folding of enums, numbers must be JSON numbers (research.md R-5). The schema version is independent of the prompt version: which prompt version ran with mr-1 is recorded per run (run.json prompt_version, mr_version). The SHA-256 of this file is pinned against version mr-1 in spec.md (Schema file pins).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "is_new_order",
    "company",
    "company_quote",
    "announcement_date",
    "announcement_date_quote",
    "order_type",
    "order_type_quote",
    "execution_period",
    "execution_period_quote",
    "orders"
  ],
  "properties": {
    "is_new_order": { "type": "boolean" },
    "company": { "$ref": "#/$defs/opt_text" },
    "company_quote": { "$ref": "#/$defs/opt_text" },
    "announcement_date": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "announcement_date_quote": { "$ref": "#/$defs/opt_text" },
    "order_type": {
      "enum": [
        "supply",
        "epc_construction",
        "services",
        "export",
        "defence",
        "government",
        "other",
        null
      ]
    },
    "order_type_quote": { "$ref": "#/$defs/opt_text" },
    "execution_period": { "$ref": "#/$defs/opt_text" },
    "execution_period_quote": { "$ref": "#/$defs/opt_text" },
    "orders": { "type": "array", "items": { "$ref": "#/$defs/mr_order" } }
  },
  "$defs": {
    "opt_text": { "type": ["string", "null"], "minLength": 1 },
    "mr_order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order_value", "currency", "unit", "client", "value_quote", "client_quote"],
      "properties": {
        "order_value": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "currency": { "enum": ["INR", "USD", "EUR", "other", null] },
        "unit": {
          "enum": ["crore", "lakh", "million", "billion", "thousand", "absolute", null]
        },
        "client": { "$ref": "#/$defs/opt_text" },
        "value_quote": { "$ref": "#/$defs/opt_text" },
        "client_quote": { "$ref": "#/$defs/opt_text" }
      }
    }
  }
}
