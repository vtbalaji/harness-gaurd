{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:order-agent:output:1.0",
  "title": "Order extraction result, schema version 1.0",
  "description": "One object per announcement (FR-001..FR-015 and FR-035, spec rev 3). Cross-field grounding rules (evidence substrings, digits, client-in-quote, evidence coverage, ranking, unstated_fields equality, the exact value_in_cr conversion) are checked in code, see research.md R-7 and the INV table in spec.md. unstated_fields is P-5, CONFIRMED by Balaji 2026-11-22. value_in_cr (rev 3, FR-035) is derived by deterministic code, never by the model, and has no evidence key. Uses only the keyword subset declared in research.md R-1. The SHA-256 of this file is pinned against version 1.0 in spec.md (Schema file pins). Version 1.0 is still pre-release: rev 3 changed these bytes before any run and before the pin was recorded (T098), so the pin records the rev 3 bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "company",
    "announcement_date",
    "order",
    "additional_orders",
    "evidence",
    "missing_fields",
    "unstated_fields",
    "rejection_reason"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "status": { "enum": ["extracted", "not_an_order", "needs_clarification", "rejected"] },
    "company": { "type": ["string", "null"], "minLength": 1 },
    "announcement_date": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "$comment": "Calendar validity (e.g. no 2026-02-30) is checked in code as OUT-DATE (layer 1)."
    },
    "order": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/order" }] },
    "additional_orders": { "type": "array", "items": { "$ref": "#/$defs/additional_order" } },
    "evidence": { "$ref": "#/$defs/top_evidence" },
    "missing_fields": {
      "type": "array",
      "items": { "enum": ["order_value", "client"] },
      "uniqueItems": true
    },
    "unstated_fields": {
      "$comment": "Spec rev 2, P-5 (CONFIRMED by Balaji 2026-11-22): the optional fields that are null. Equality with the set of null optional fields is INV-10 (layer 2), checked in code.",
      "type": "array",
      "items": { "enum": ["company", "announcement_date", "order_type", "execution_period"] },
      "uniqueItems": true
    },
    "rejection_reason": { "enum": ["empty", "whitespace_only", "too_long", "garbled", null] }
  },
  "allOf": [
    {
      "$comment": "FR-015: extracted => order non-null, missing_fields empty, rejection_reason null",
      "if": { "properties": { "status": { "const": "extracted" } } },
      "then": {
        "properties": {
          "order": { "type": "object" },
          "missing_fields": { "maxItems": 0 },
          "rejection_reason": { "const": null }
        }
      }
    },
    {
      "$comment": "FR-015: needs_clarification => order non-null, missing_fields non-empty, rejection_reason null",
      "if": { "properties": { "status": { "const": "needs_clarification" } } },
      "then": {
        "properties": {
          "order": { "type": "object" },
          "missing_fields": { "minItems": 1 },
          "rejection_reason": { "const": null }
        }
      }
    },
    {
      "$comment": "FR-015: not_an_order => order null, additional_orders empty, missing_fields empty, unstated_fields only company/announcement_date, rejection_reason null",
      "if": { "properties": { "status": { "const": "not_an_order" } } },
      "then": {
        "properties": {
          "order": { "type": "null" },
          "additional_orders": { "maxItems": 0 },
          "missing_fields": { "maxItems": 0 },
          "unstated_fields": { "items": { "enum": ["company", "announcement_date"] } },
          "rejection_reason": { "const": null }
        }
      }
    },
    {
      "$comment": "FR-015: rejected => company, announcement_date, order null; additional_orders empty; evidence {}; missing_fields empty; unstated_fields empty; rejection_reason non-null",
      "if": { "properties": { "status": { "const": "rejected" } } },
      "then": {
        "properties": {
          "company": { "type": "null" },
          "announcement_date": { "type": "null" },
          "order": { "type": "null" },
          "additional_orders": { "maxItems": 0 },
          "evidence": { "maxProperties": 0 },
          "missing_fields": { "maxItems": 0 },
          "unstated_fields": { "maxItems": 0 },
          "rejection_reason": { "enum": ["empty", "whitespace_only", "too_long", "garbled"] }
        }
      }
    }
  ],
  "$defs": {
    "quote": { "type": "string", "minLength": 1 },
    "order_value": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "currency": { "enum": ["INR", "USD", "EUR", "other", null] },
    "unit": { "enum": ["crore", "lakh", "million", "billion", "thousand", "absolute", null] },
    "client": { "type": ["string", "null"], "minLength": 1 },
    "value_in_cr": {
      "$comment": "Spec rev 3, FR-035: order_value converted to crore by deterministic code (crore x1, lakh x0.01, million x0.1, billion x100, thousand x0.0001, absolute x1e-7; exact decimal arithmetic, ROUND_HALF_UP to 4 decimals) when currency is INR, otherwise null. No lower bound here: an INR amount below 500 absolute rounds to 0. The exact value is INV-11 (layer 2), checked in code.",
      "type": ["number", "null"]
    },
    "value_in_cr_rule": {
      "$comment": "FR-035 shape: value_in_cr is a number if and only if currency is INR; null for USD, EUR, other and a null currency (no FX conversion).",
      "anyOf": [
        {
          "properties": {
            "currency": { "const": "INR" },
            "value_in_cr": { "type": "number" }
          }
        },
        {
          "properties": {
            "currency": { "enum": ["USD", "EUR", "other", null] },
            "value_in_cr": { "type": "null" }
          }
        }
      ]
    },
    "order_type": {
      "enum": ["supply", "epc_construction", "services", "export", "defence", "government", "other"]
    },
    "value_triplet": {
      "$comment": "FR-006: currency and unit are null if and only if order_value is null",
      "anyOf": [
        {
          "properties": {
            "order_value": { "type": "number" },
            "currency": { "type": "string" },
            "unit": { "type": "string" }
          }
        },
        {
          "properties": {
            "order_value": { "type": "null" },
            "currency": { "type": "null" },
            "unit": { "type": "null" }
          }
        }
      ]
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order_value",
        "currency",
        "unit",
        "value_in_cr",
        "client",
        "order_type",
        "execution_period"
      ],
      "properties": {
        "order_value": { "$ref": "#/$defs/order_value" },
        "currency": { "$ref": "#/$defs/currency" },
        "unit": { "$ref": "#/$defs/unit" },
        "value_in_cr": { "$ref": "#/$defs/value_in_cr" },
        "client": { "$ref": "#/$defs/client" },
        "order_type": { "$ref": "#/$defs/order_type" },
        "execution_period": { "type": ["string", "null"], "minLength": 1 }
      },
      "allOf": [{ "$ref": "#/$defs/value_triplet" }, { "$ref": "#/$defs/value_in_cr_rule" }]
    },
    "additional_order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order_value", "currency", "unit", "value_in_cr", "client", "evidence"],
      "properties": {
        "order_value": { "$ref": "#/$defs/order_value" },
        "currency": { "$ref": "#/$defs/currency" },
        "unit": { "$ref": "#/$defs/unit" },
        "value_in_cr": { "$ref": "#/$defs/value_in_cr" },
        "client": { "$ref": "#/$defs/client" },
        "evidence": {
          "$comment": "value_in_cr has no evidence key (FR-035): it is derived from order_value, whose quote covers it.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "order_value": { "$ref": "#/$defs/quote" },
            "currency": { "$ref": "#/$defs/quote" },
            "unit": { "$ref": "#/$defs/quote" },
            "client": { "$ref": "#/$defs/quote" }
          }
        }
      },
      "allOf": [{ "$ref": "#/$defs/value_triplet" }, { "$ref": "#/$defs/value_in_cr_rule" }]
    },
    "top_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "company": { "$ref": "#/$defs/quote" },
        "announcement_date": { "$ref": "#/$defs/quote" },
        "order_value": { "$ref": "#/$defs/quote" },
        "currency": { "$ref": "#/$defs/quote" },
        "unit": { "$ref": "#/$defs/quote" },
        "client": { "$ref": "#/$defs/quote" },
        "order_type": { "$ref": "#/$defs/quote" },
        "execution_period": { "$ref": "#/$defs/quote" }
      }
    }
  }
}
