# Endpoints and model identity for the order extraction agent (spec FR-021, research.md R-10).
# Copy to .env (git-ignored): cp .env.example .env
# Nothing confidential belongs in this file. The generation settings (temperature, seed,
# num_predict, think, format, timeout, num_ctx formula) and the model/runner pins are code
# constants in src/order_agent/config.py and are NOT configurable here. AGENT_MODEL and
# AGENT_MODEL_DIGEST only confirm identity: a value that differs from the pins makes an
# evaluation INCONCLUSIVE.
OLLAMA_URL=http://localhost:11434
AGENT_MODEL=qwen3.5:4b
AGENT_MODEL_DIGEST=d8b0f5e9760c
JUDGE_URL=http://127.0.0.1:8081/v1/chat/completions
JUDGE_MODEL=qwen3.6-35b-a3b
